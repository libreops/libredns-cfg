-- Open ACL to the Internet
setACL("::/0")
addACL("0.0.0.0/0")

-- accept DNS queries on UDP and TCP
setLocal('{{ IPv4 }}:53')
addLocal('[{{ IPv6 }}]:53')

-- DNS over TLS - 1 local per CPU
{% for vcpus in range(ansible_facts['processor_vcpus']) %}
addTLSLocal({{ "%-26s" | format("'" ~ IPv4 ~ "',") }} '/etc/dnsdist/fullchain.cer', '/etc/dnsdist/{{ DOMAIN }}.key', { reusePort=true } )
addTLSLocal({{ "%-26s" | format("'[" ~ IPv6 ~ "]',") }} '/etc/dnsdist/fullchain.cer', '/etc/dnsdist/{{ DOMAIN }}.key', { reusePort=true } )
{% endfor %}

-- DNS over TLS, noads
addTLSLocal({{ "%-30s" | format("'" ~ IPv4 ~ ":854',") }} '/etc/dnsdist/fullchain.cer', '/etc/dnsdist/{{ DOMAIN }}.key', { reusePort=true } )
addTLSLocal({{ "%-30s" | format("'[" ~ IPv6 ~ "]:854',") }} '/etc/dnsdist/fullchain.cer', '/etc/dnsdist/{{ DOMAIN }}.key', { reusePort=true } )

-- DNS over HTTPS, plain HTTP/2 (h2c) behind nginx grpc_pass
-- dnsdist 2.1 only supports nghttp2, which does not speak HTTP/1.1
addDOHLocal("127.0.0.1:8053", nil, nil, "/dns-query", { reusePort=true, trustForwardedForHeader=true })
-- DNS over HTTPS - noads
addDOHLocal("127.0.0.1:8054", nil, nil, "/ads", { reusePort=true, trustForwardedForHeader=true })

-- Filter DNS queries to backend DNS based on endpoint
newServer({address="127.0.0.1:5454", pool="ads"})
addAction(HTTPPathRule("/ads"), PoolAction("ads"))

-- DoT noads
addAction(SNIRule("noads.{{ DOMAIN }}"), PoolAction("ads"))
addAction(DSTPortRule(854), PoolAction("ads"))

-- fwd queries to:
{% for vcpus in range(ansible_facts['processor_vcpus']) %}
newServer({address="127.0.0.1:5353"})
{% endfor %}

-- Fix TCP threads (handles the 443 overflow)
setMaxTCPClientThreads(10)

-- Increase TCP queue size
setMaxTCPQueuedConnections(10000)

-- Increase internal backend connections to pdns:5454
-- This fixes the 127.0.0.1:5454 SYN flooding
--setMaxTCPConnectionsPerDownstream(1000)

-- DDOS protection

-- prevent lock contention between threads, keep under 1m
setRingBuffersSize(30000, 30)

-- create Dynamic Block Rules Group object, to add rules
local dbr = dynBlockRulesGroup()

-- queries per second, how many seconds, msg, temp block in sec
dbr:setQueryRate(30, 10, "Exceeded query rate", 120)

-- prevent DDoS by querying Non eXisting Domains & Server failure
dbr:setRCodeRate(DNSRCode.NXDOMAIN, 10, 10, "Exceeded NXD rate", 120)
dbr:setRCodeRate(DNSRCode.SERVFAIL, 10, 10, "Exceeded ServFail rate", 120)

-- rate limit ANY queries
dbr:setQTypeRate(DNSQType.ANY, 5, 10, "Exceeded ANY rate", 120)

-- limit large responses, that would produce amplification
dbr:setResponseByteRate(10000, 10, "Exceeded responses bandwidth rate", 120)

-- exclude localhost from rules
dbr:excludeRange({"127.0.0.0/8"})

function maintenance()
    dbr:apply()
end

-- Bootstrapping DOH and DOT
addAction(AndRule({DSTPortRule(53),makeRule("{{ DOMAIN }}")}),SpoofAction({"{{ IPv4 }}", "{{ IPv6 }}"}))
-- addAction(AndRule({DSTPortRule(53),makeRule("{{ DOMAIN }}")}),SpoofAction("{{ IPv4 }}"))

addAction("127.0.0.1/8", AllowAction())
addAction(DSTPortRule(53),DropAction())

