########################
## {{ ansible_managed }}

upstream dns-over-https-ads {
    server 127.0.0.1:8054;
    keepalive 64;
}

upstream dns-over-https {
    server 127.0.0.1:8053;
    keepalive 64;
}

server {
    listen 80;
    listen [::]:80;
    server_name doh.{{ DOMAIN }};

    return 301 https://{{ DOMAIN }}$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name doh.{{ DOMAIN }};

    ssl_certificate /root/.acme.sh/{{ DOMAIN }}/fullchain.cer;
    ssl_certificate_key /root/.acme.sh/{{ DOMAIN }}/{{ DOMAIN }}.key;

    location / {
        return 301 https://{{ DOMAIN }}$request_uri;
    }

    # dnsdist 2.1 serves DoH over HTTP/2 only (nghttp2), so pass the
    # queries with grpc_pass, which speaks plain HTTP/2 to the upstream
    location /ads {
        grpc_set_header Host $host;
        grpc_set_header X-Real-IP $remote_addr;
        grpc_set_header X-Forwarded-For $remote_addr;
        grpc_pass grpc://dns-over-https-ads;

        # in each DoH location
        grpc_connect_timeout 2s;
        grpc_read_timeout 5s;
    }

    location /noads {
        rewrite ^/noads(.*)$ /ads$1 break;
        grpc_set_header Host $host;
        grpc_set_header X-Real-IP $remote_addr;
        grpc_set_header X-Forwarded-For $remote_addr;
        grpc_pass grpc://dns-over-https-ads;

        # in each DoH location
        grpc_connect_timeout 2s;
        grpc_read_timeout 5s;
    }

    location /dns-query {
        grpc_set_header Host $host;
        grpc_set_header X-Real-IP $remote_addr;
        grpc_set_header X-Forwarded-For $remote_addr;
        grpc_pass grpc://dns-over-https;

        # in each DoH location
        grpc_connect_timeout 2s;
        grpc_read_timeout 5s;
    }
}
